# Agent Swarm dashboard (apps/ui) Dockerfile
# Static SPA: built once on the build host's platform, served by unprivileged nginx.
# The final stage only copies files, so a multi-platform build needs no emulation.

# Stage 1: Build the SPA (pinned — keep in sync with Dockerfile's builder)
FROM --platform=$BUILDPLATFORM oven/bun:1.4.0 AS builder

WORKDIR /build

# The frozen install resolves the whole workspace graph, so every member manifest and
# bunfig.toml must be present (see Dockerfile).
COPY package.json bun.lock* bunfig.toml ./
COPY apps/ui/package.json ./apps/ui/package.json
COPY apps/templates-ui/package.json ./apps/templates-ui/package.json
COPY apps/evals/package.json ./apps/evals/package.json
COPY packages/model-catalog/package.json ./packages/model-catalog/package.json
COPY packages/model-routing/package.json ./packages/model-routing/package.json
RUN bun install --frozen-lockfile

# apps/ui imports a few shared modules from the root src/ (task citations, dsh usage).
COPY packages/model-catalog/ ./packages/model-catalog/
COPY src/ ./src/
COPY apps/ui/ ./apps/ui/
RUN cd apps/ui && bun run build

# Stage 2: Serve the static files
FROM nginxinc/nginx-unprivileged:1.29-alpine

COPY apps/ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/apps/ui/dist /usr/share/nginx/html

EXPOSE 8080
