# Agent Swarm dashboard (apps/ui) served by nginx

FROM --platform=$BUILDPLATFORM oven/bun:1.4.0 AS builder

WORKDIR /build

COPY package.json bun.lock* bunfig.toml ./
COPY apps/ui/package.json ./apps/ui/package.json
COPY apps/templates-ui/package.json ./apps/templates-ui/package.json
COPY apps/evals/package.json ./apps/evals/package.json
COPY packages/model-catalog/package.json ./packages/model-catalog/package.json
COPY packages/model-routing/package.json ./packages/model-routing/package.json
RUN bun install --frozen-lockfile

# apps/ui imports shared modules from the root src/.
COPY packages/model-catalog/ ./packages/model-catalog/
COPY src/ ./src/
COPY apps/ui/ ./apps/ui/
RUN cd apps/ui && bun run build

FROM nginxinc/nginx-unprivileged:1.29.8-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6

COPY apps/ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/apps/ui/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO /dev/null http://127.0.0.1:8080/healthz || exit 1
